[Unit]
Description=QuantGrid read-only host health watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/QuantGrid
ExecStart=/usr/bin/python3 /root/QuantGrid/scripts/host_watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal
