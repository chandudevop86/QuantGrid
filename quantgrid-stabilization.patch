+def _row_time(row: dict[str, Any]) -> datetime | None:
+    raw = row.get("closed_at") or row.get("created_at") or row.get("timestamp")
+    if raw in {None, ""}:
+        return None
+    try:
+        value = datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    if value.tzinfo is None:
